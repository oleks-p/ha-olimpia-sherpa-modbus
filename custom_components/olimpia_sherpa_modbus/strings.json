  "config": {
    "step": {
      "user": {
        "title": "How is the Sherpa connected?",
        "description": "The integration only reads: it never changes a setting on the unit. RS-485 allows one master, so stop anything else that polls the Sherpa (an old `modbus:` configuration, another controller) before adding it.",
        "menu_options": {
          "serial": "USB / RS-485 adapter",
          "network": "Network gateway"
        }
      },
      "serial": {
        "title": "RS-485 adapter",
        "description": "Terminal AB on the indoor unit, 8N1. Prefer a /dev/serial/by-id path: it survives reboots and replugging.",
