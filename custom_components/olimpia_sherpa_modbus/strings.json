          "serial_port": "Serial port",
          "baudrate": "Baud rate",
          "slave": "Modbus address",
          "entity_prefix": "Entity ID prefix"
        },
        "data_description": {
          "slave": "Parameter ADDR247 on the unit's SERVICE screen (factory default 1).",
          "entity_prefix": "Every entity id starts with it, e.g. sensor.sherpa_water_in. Keep \"sherpa\" to take over the entity ids, history and statistics of an existing YAML setup."
        }
      },
      "network": {
        "title": "Network gateway",
        "description": "A gateway wired to terminal AB on the indoor unit.",
        "data": {
          "host": "Host",
          "port": "Port",
          "transport": "Gateway type",
          "slave": "Modbus address",
          "entity_prefix": "Entity ID prefix"
        },
